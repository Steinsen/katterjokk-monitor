{
  "name": "katterjokk-monitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "db:init": "wrangler d1 execute katterjokk-monitor --remote --file schema.sql",
    "db:init:local": "wrangler d1 execute katterjokk-monitor --local --file schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261007.1",
    "@types/node": "^26.6.4",
    "typescript": "^5.9.0",
    "wrangler": "^4.0.0"
  }
}
